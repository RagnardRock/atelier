{
  "name": "atelier-tableur",
  "productName": "Reikna",
  "version": "0.4.0",
  "description": "Reikna, mon tableur : ouvre et enregistre les classeurs Excel (xlsx, xls), LibreOffice (ods) et CSV, avec toutes les formules en français, un des outils d'Atelier",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node ../commun/copier.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "author": "Ragna",
  "build": {
    "appId": "fr.ragna.reikna",
    "productName": "Reikna",
    "copyright": "Ragna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asarUnpack": [
      "commun/mcp-commun.js"
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "build/icon.ico",
      "build/icon.png",
      "!mettre-a-jour.*",
      "!node_modules/exceljs/{lib,excel.js,index.*}",
      "!node_modules/exceljs/dist/es5/**",
      "!node_modules/exceljs/dist/*.map",
      "!node_modules/@e965/xlsx/{bin,types,*.mjs}",
      "!node_modules/@e965/xlsx/dist/*.map",
      "!node_modules/hyperformula/{es,commonjs,typings}/**",
      "!node_modules/hyperformula/dist/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "Reikna"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reikna",
      "artifactName": "Reikna-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Reikna",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/RagnardRock/atelier/releases/latest/download"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@vscode/codicons": "^0.0.45",
    "chart.js": "^4.6.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "hyperformula": "^3.5.0",
    "jszip": "^3.10.2"
  },
  "private": true
}
