{
  "name": "atelier-ide",
  "productName": "Rune",
  "version": "0.13.0",
  "description": "Rune, mon IDE perso (Electron + Monaco), un des outils d'Atelier",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "author": "Ragna",
  "build": {
    "appId": "fr.ragna.rune",
    "productName": "Rune",
    "copyright": "Ragna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "build/icon.ico",
      "build/icon.png",
      "!node_modules/monaco-editor/{dev,esm,min-maps}/**"
    ],
    "asar": false,
    "npmRebuild": false,
    "onNodeModuleFile": "build/garder-fichiers.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "Rune"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rune",
      "artifactName": "Rune-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Rune",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RagnardRock",
        "repo": "atelier",
        "releaseType": "release",
        "tagNamePrefix": "rune-v"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "@vue/language-server": "3.3.13",
    "@vue/typescript-plugin": "3.3.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "6.8.9",
    "emmet-monaco-es": "5.7.0",
    "htmlhint": "^1.9.2",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vscode-jsonrpc": "9.0.3"
  },
  "private": true
}
