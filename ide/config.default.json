{
  "theme": "vs-dark",
  "glass": true,
  "windowBlur": false,
  "accentColor": "#e0a526",
  "fontFamily": "'Cascadia Code', Consolas, monospace",
  "fontSize": 15,
  "tabSize": 2,
  "wordWrap": "on",
  "minimap": true,
  "reopenLastFolder": true,
  "claudeCommand": "claude",
  "claudeModel": "",
  "claudePermissionMode": "ask",
  "terminalFontSize": 14,
  "terminalProfiles": [
    { "name": "PowerShell", "command": "default", "args": [] }
  ],
  "htmlRules": {},
  "shortcuts": {
    "toggleTerminal": "Ctrl+J",
    "splitEditor": "Ctrl+Alt+D",
    "toggleClaude": "Ctrl+Shift+I",
    "quickOpen": "Ctrl+P",
    "searchProject": "Ctrl+Shift+F"
  }
}
