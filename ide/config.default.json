{
  "theme": "vs-dark",
  "glass": true,
  "windowBlur": false,
  "accentColor": "#e0a526",
  "fontFamily": "'Cascadia Code', Consolas, monospace",
  "fontSize": 15,
  "tabSize": 2,
  "wordWrap": "on",
  "minimap": true,
  "emmet": true,
  "vueTools": true,
  "formatOnSave": false,
  "reopenLastFolder": true,
  "restoreTabs": true,
  "projectsFolder": "D:\\Projets",
  "previewLive": true,
  "previewPort": 5500,
  "claudeCommand": "claude",
  "claudeModel": "",
  "claudePermissionMode": "ask",
  "claudeSansDemander": {},
  "claudeAtelier": true,
  "terminalFontSize": 14,
  "terminalProfiles": [
    { "name": "PowerShell", "command": "default", "args": [] }
  ],
  "htmlRules": {},
  "shortcuts": {
    "toggleTerminal": "Ctrl+J",
    "splitEditor": "Ctrl+Alt+D",
    "closeColumn": "Ctrl+Alt+W",
    "newProject": "Ctrl+Alt+N",
    "toggleClaude": "Ctrl+Shift+I",
    "quickOpen": "Ctrl+P",
    "commandPalette": "Ctrl+Shift+P",
    "searchProject": "Ctrl+Shift+F",
    "replaceProject": "Ctrl+Shift+H",
    "togglePreview": "Ctrl+Alt+P"
  }
}
