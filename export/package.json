{
  "name": "atelier-export",
  "productName": "Brokk",
  "version": "0.1.0",
  "description": "Brokk, mon outil d'export d'assets : un PSD, un logo ou une image devient d'un coup toutes les tailles web d'un projet (favicon, icônes, WebP, @2x, Open Graph), un des outils d'Atelier",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "author": "Ragna",
  "build": {
    "appId": "fr.ragna.brokk",
    "productName": "Brokk",
    "copyright": "Ragna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "build/icon.ico",
      "build/icon.png",
      "!node_modules/ag-psd/{src,dist-es}/**",
      "!node_modules/ag-psd/dist/*.map",
      "!mettre-a-jour.*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "Brokk"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Brokk",
      "artifactName": "Brokk-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Brokk",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/RagnardRock/atelier/releases/latest/download"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.45",
    "ag-psd": "31.0.3",
    "electron-updater": "6.8.9"
  },
  "private": true
}
