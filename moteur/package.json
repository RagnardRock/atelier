{
  "name": "atelier-moteur",
  "productName": "Saga",
  "version": "0.13.0",
  "description": "Saga, le moteur qui fait tourner les jeux décrits dans Tafl (cartes, calques, parallaxe, déplacements, téléporteurs, météo), un des outils d'Atelier",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node ../commun/copier.js github.js bac-a-sable.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "author": "Ragna",
  "build": {
    "appId": "fr.ragna.saga",
    "productName": "Saga",
    "copyright": "Ragna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "build/icon.ico",
      "build/icon.png",
      "!mettre-a-jour.*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "Saga"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Saga",
      "artifactName": "Saga-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Saga",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/RagnardRock/atelier/releases/latest/download"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.45",
    "electron-updater": "6.8.9"
  },
  "private": true
}
