{
  "name": "atelier-hub",
  "productName": "Atelier",
  "version": "0.15.0",
  "description": "Atelier, le hub de mes outils : lance Rune, Skald et les suivants, les installe et les met à jour, et réunit mes widgets (notes…)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node ../commun/copier.js github.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "author": "Ragna",
  "build": {
    "appId": "fr.ragna.atelier",
    "productName": "Atelier",
    "copyright": "Ragna",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asarUnpack": [
      "mcp-atelier.js"
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "build/icon.ico",
      "build/icon.png",
      "!mettre-a-jour.*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "Atelier"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atelier",
      "artifactName": "Atelier-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Atelier",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/RagnardRock/atelier/releases/latest/download"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.45",
    "electron-updater": "6.8.9"
  },
  "private": true
}
